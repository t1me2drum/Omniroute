<Page
    x:Class="Omniroute.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Omniroute.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Мої станції" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <CommandBar HorizontalAlignment="Right" DefaultLabelPosition="Right">
                <AppBarButton Icon="Refresh" Label="Оновити" Click="RefreshButton_Click"/>
                <AppBarButton Icon="Add" Label="Додати" Click="AddButton_Click"/>
                <AppBarButton Icon="Setting" Label="Налаштування" Click="SettingsButton_Click"/>
            </CommandBar>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Loading State -->
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Завантаження станцій..." FontSize="16"/>
            </StackPanel>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
                <FontIcon Glyph="&#xE895;" FontSize="64" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Text="Немає станцій" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Додайте свою першу станцію EcoFlow"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          HorizontalAlignment="Center"/>
                <Button Content="Додати станцію" Click="AddButton_Click" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <!-- Devices Grid -->
            <ScrollViewer x:Name="DevicesScrollViewer" Padding="16">
                <ItemsRepeater x:Name="DevicesRepeater" ItemsSource="{x:Bind Devices}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="300" MinItemHeight="250" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Device">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                   BorderThickness="1"
                                   CornerRadius="8"
                                   Padding="16">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Назва, модель і статус -->
                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind ModelName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                     Visibility="{x:Bind IsOnline, Mode=OneWay}"/>
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{ThemeResource TextFillColorDisabledBrush}"
                                                     Visibility="{x:Bind IsOffline, Mode=OneWay}"/>
                                            <TextBlock Text="{x:Bind OnlineText, Mode=OneWay}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Заряд -->
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="{x:Bind BatteryText, Mode=OneWay}" FontSize="40" FontWeight="SemiBold" LineHeight="44"/>
                                        <TextBlock Text="{x:Bind GridText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="2" Value="{x:Bind BatteryPercent, Mode=OneWay}" Maximum="100"/>

                                    <!-- Потужності -->
                                    <Grid Grid.Row="3" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Вхід" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind InputText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Вихід" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind OutputText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Дії -->
                                    <Button Grid.Row="5" Content="Детальніше" HorizontalAlignment="Stretch" Click="DeviceButton_Click" Tag="{x:Bind SerialNumber}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
