<Page
    x:Class="PowerHub.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8,8,16,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="BackButton_Click" Style="{StaticResource NavigationBackButtonNormalStyle}"/>
                <TextBlock Text="Налаштування" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                <InfoBar x:Name="ConnectionBar" IsClosable="False" IsOpen="False"/>

                <!-- Акаунт -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Акаунт" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock x:Name="EmailText" Text="Email: —" Style="{StaticResource HintStyle}"/>
                        <Button Content="Вийти з облікового запису" Click="LogoutButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Тема -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Вигляд" Style="{StaticResource CardTitleStyle}"/>
                        <RadioButtons x:Name="LayoutButtons" Header="Головний екран" MaxColumns="2" SelectionChanged="LayoutButtons_SelectionChanged">
                            <x:String>Компактний список</x:String>
                            <x:String>Дашборд плиток</x:String>
                        </RadioButtons>
                        <RadioButtons x:Name="ThemeButtons" Header="Тема" MaxColumns="3" SelectionChanged="ThemeButtons_SelectionChanged">
                            <x:String>Темна</x:String>
                            <x:String>Світла</x:String>
                            <x:String>Як у системі</x:String>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <!-- Робота у фоні -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Робота у фоні" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Моніторинг тримає постійне з'єднання, щоб сповіщення приходили вчасно. Іконка в треї показує заряд станцій; правий клік — меню з пунктом «Вийти»."/>
                        <ToggleSwitch x:Name="CloseToTrayToggle" Header="Закриття вікна ховає застосунок у трей" Toggled="CloseToTrayToggle_Toggled"/>
                        <ToggleSwitch x:Name="AutostartToggle" Header="Запускати разом з Windows (одразу в треї)" Toggled="AutostartToggle_Toggled"/>
                    </StackPanel>
                </Border>

                <!-- Ключі Developer API -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Список станцій з акаунта" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Ключі з developer.ecoflow.com. З ними станції підтягуються автоматично, з назвами й моделями, однаково на всіх пристроях."/>
                        <TextBox x:Name="AccessKeyBox" Header="Access Key"/>
                        <PasswordBox x:Name="SecretKeyBox" Header="Secret Key"/>
                        <TextBlock x:Name="KeysMessage" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SaveKeysButton" Content="Зберегти" Click="SaveKeysButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="ClearKeysButton" Content="Видалити ключі" Click="ClearKeysButton_Click"/>
                            <ProgressRing x:Name="KeysProgress" IsActive="False" Width="20" Height="20"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Видалені станції -->
                <Border x:Name="HiddenCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Видалені станції" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Style="{StaticResource HintStyle}" Text="Є в акаунті EcoFlow, але приховані в PowerHub."/>
                        <StackPanel x:Name="HiddenList" Spacing="8"/>
                    </StackPanel>
                </Border>

                <!-- Сповіщення -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Сповіщення" Style="{StaticResource CardTitleStyle}"/>
                        <ToggleSwitch x:Name="NotificationsToggle" Header="Показувати сповіщення Windows" Toggled="NotificationToggle_Toggled"/>
                        <ToggleSwitch x:Name="PowerLossToggle" Header="Живлення: зникло, з'явилося, слабка напруга" Toggled="NotificationToggle_Toggled"/>
                        <TextBlock x:Name="WeakGridLabel" Style="{StaticResource HintStyle}"/>
                        <Slider x:Name="WeakGridSlider" Minimum="150" Maximum="210" StepFrequency="5" TickFrequency="5"
                                SnapsTo="StepValues" ValueChanged="WeakGridSlider_ValueChanged"/>
                        <ToggleSwitch x:Name="LowBatteryToggle" Header="Низький заряд" Toggled="NotificationToggle_Toggled"/>
                        <TextBlock x:Name="LowBatteryLabel" Style="{StaticResource HintStyle}"/>
                        <Slider x:Name="LowBatterySlider" Minimum="5" Maximum="50" StepFrequency="5" TickFrequency="5"
                                SnapsTo="StepValues" ValueChanged="LowBatterySlider_ValueChanged"/>
                        <ToggleSwitch x:Name="FullChargeToggle" Header="Повністю заряджено" Toggled="NotificationToggle_Toggled"/>
                        <ToggleSwitch x:Name="OfflineToggle" Header="Станція не на зв'язку" Toggled="NotificationToggle_Toggled"/>
                    </StackPanel>
                </Border>

                <!-- Діагностика -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Діагностика" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock x:Name="DiagText" Style="{StaticResource HintStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Відкрити журнал" Click="OpenLogButton_Click"/>
                            <Button Content="Копіювати" Click="CopyLogButton_Click"/>
                            <Button Content="Очистити" Click="ClearLogButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Про застосунок -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Про застосунок" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource HintStyle}"/>
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Протокол взято з відкритого проєкту tolwi/hassio-ecoflow-cloud (Apache-2.0). Це неофіційний клієнт, EcoFlow може змінити API без попередження."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
